{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Serve dist/about/index.html at /about (and 307 /about/ -> /about) so the
    // slash-less URLs in sitemap.xml return 200 instead of redirecting.
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
  // TODO: joke feature is pending. Create the D1 database, put its ID below and
  // uncomment this block, then run `npm run db:migrate:remote` to enable /api/joke.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "jokes-db",
  //     "database_id": "REPLACE_WITH_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
